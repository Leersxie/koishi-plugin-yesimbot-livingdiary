{
  "name": "koishi-plugin-yesimbot-livingdiary",
  "version": "1.0.2",
  "description": "YesImBot 扩展：QQ 空间生活日记（自动记录并发布日记、读写空间动态、自动互动）",
  "homepage": "https://github.com/Leersxie/koishi-plugin-yesimbot-livingdiary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leersxie/koishi-plugin-yesimbot-livingdiary.git"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "yesimbot",
    "qzone",
    "qq空间",
    "生活日记",
    "autoreply"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "koishi": {
    "description": {
      "en": "YesImBot living diary: auto publish QQ-Zone diary posts, read feeds and interact.",
      "zh": "YesImBot 扩展：自动记录并发布空间日记、读写动态、自动互动。"
    },
    "service": {
      "required": [
        "database",
        "yesimbot"
      ],
      "optional": [
        "yesimbot.model",
        "yesimbot.world-state",
        "yesimbot.memory"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w --preserveWatchOutput",
    "clean": "node -e "fs.rmSync('lib',{recursive:true,force:true})""
  },
  "license": "MIT",
  "peerDependencies": {
    "koishi": "^4.18.7",
    "koishi-plugin-yesimbot": "^3.0.3"
  },
  "dependencies": {
    "qzone-sdk": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "koishi": "^4.18.7",
    "koishi-plugin-yesimbot": "^3.0.3",
    "typescript": "^5.6.0"
  }
}
